[Unit]
Description=VProvider - Hafif Yerel Yapay Zeka Model Sunucusu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_ROOT}}
EnvironmentFile={{PROJECT_ROOT}}/.env
ExecStart={{PROJECT_ROOT}}/.venv/bin/uvicorn app.main:app --host {{HOST}} --port {{PORT}}
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target